<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="10.1.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="FluentAssertions" Version="8.11.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="Reqnroll" Version="3.3.4" />
		<PackageReference Include="Reqnroll.xunit.v3" Version="3.3.4" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Domain\DeterministicAiLab.Domain\DeterministicAiLab.Domain.csproj" />
	</ItemGroup>


	<ItemGroup>
		<ReqnrollFeatureFiles Include="..\..\docs\specs\**\*.feature">
			<Link>Features\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</ReqnrollFeatureFiles>
	</ItemGroup>


	<ItemGroup>
	  <Compile Remove="Steps\**" />
	  <EmbeddedResource Remove="Steps\**" />
	  <None Remove="Steps\**" />
	  <ReqnrollFeatureFile Remove="Steps\**" />
	</ItemGroup>

	<PropertyGroup>
		<ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
	</PropertyGroup>

	<ItemGroup>
	  <ReqnrollObsoleteCodeBehindFiles Remove="Steps\**" />
	</ItemGroup>

	<ItemGroup>
	  <ReqnrollLegacyCodeBehindFiles Remove="Steps\**" />
	</ItemGroup>

</Project>
